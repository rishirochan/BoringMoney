{
  "name": "boringmoney",
  "version": "1.0.0",
  "packageManager": "pnpm@10.30.3",
  "description": "A private, local-first personal finance dashboard.",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.electron.json && vite build",
    "dev": "pnpm build && electron .",
    "start": "electron .",
    "check": "tsc --noEmit -p tsconfig.electron.json && tsc --noEmit",
    "package": "pnpm build && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rishirochan/BoringMoney.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/rishirochan/BoringMoney/issues"
  },
  "homepage": "https://github.com/rishirochan/BoringMoney#readme",
  "build": {
    "appId": "com.rishirochan.boringmoney",
    "productName": "Boring Money",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
